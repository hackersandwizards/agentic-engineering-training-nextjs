# https://editorconfig.org
# Mirrors .prettierrc.json so editors and Prettier agree.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

# Trailing whitespace is significant in Markdown (hard line breaks).
[*.md]
trim_trailing_whitespace = false
